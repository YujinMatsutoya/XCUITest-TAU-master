default_platform(:ios)

platform :ios do
  desc "Run XCUITests on the simulator"
  lane :ui_tests do
    scan(
      project: "TAU.xcodeproj",      # or workspace: "YourApp.xcworkspace"
      scheme: "TAU",
      device: "iPhone 17",
      only_testing: ["TAUUITests"],  # remove to run every test in the scheme
      result_bundle: true,
      output_directory: "./fastlane/test_output",
      number_of_retries: 2               # retries flaky UI tests once
    )
  end
end
